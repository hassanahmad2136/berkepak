# Saleor backend env reference. The current docker-compose embeds these inline
# under `environment:` blocks for simplicity. Move to this file via `env_file:`
# if you want to separate config from compose. DO NOT commit real secrets.

SECRET_KEY=dev-secret-key-change-me
DATABASE_URL=postgres://saleor:saleor@db/saleor
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=noreply@berkepak.local
ALLOWED_HOSTS=localhost,127.0.0.1,api
ALLOWED_CLIENT_HOSTS=localhost,127.0.0.1,localhost:3000,localhost:9000
DEFAULT_CHANNEL_SLUG=default-channel
DASHBOARD_URL=http://localhost:9000/
