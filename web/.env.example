# --- Database ---
# Postgres from db/docker-compose.yml. Supabase has been removed.
DATABASE_URL=postgresql://berkepak:berkepak_dev@localhost:5433/berkepak
# Set to "true" for managed providers (Neon/RDS) that require TLS.
DATABASE_SSL=false

# Used for email confirmation and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin ---
# Comma-separated emails granted access to /admin/*. The admin_users table
# works too; either grants access.
ADMIN_EMAILS=
# Optional: where admin action alerts are sent.
ADMIN_NOTIFY_EMAILS=

# --- Object storage (S3-compatible: MinIO locally, S3/R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=berkepak
S3_SECRET_KEY=berkepak_dev_secret
S3_REGION=us-east-1
# Public base URL for product images, if it differs from S3_ENDPOINT (e.g. a CDN).
S3_PUBLIC_URL=

# --- Email (SMTP) ---
# REQUIRED. Signup verification is mandatory, so with SMTP down nobody can
# register. Locally, Mailpit (db/docker-compose.yml) catches everything:
#   SMTP_HOST=localhost, SMTP_PORT=1025, inbox at http://localhost:8025
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@berkepakfabrics.com

# Dev-only break-glass: when "true", signup marks the account verified and
# signs the user straight in, so local work survives an SMTP outage.
# Ignored in production.
AUTH_AUTO_VERIFY=false

# --- Payments ---
# Online payment (PayFast) is switched off: checkout offers only direct bank
# transfer and cash on delivery, and listed prices carry no gateway fee. Set to
# "true" to bring the online option back - that also turns the fee gross-up on,
# so every listed price rises. Restart or rebuild after changing it.
NEXT_PUBLIC_ONLINE_PAYMENTS=false

# Which gateway serves the online option at checkout:
#   mock     sandbox simulator - drives the real webhook path, no money moves.
#            The registry refuses it in production.
#   payfast  PayFast hosted checkout (cards, wallets, bank accounts).
#   onelink  1LINK 1GO Raast (wire format unverified).
PAYMENTS_PROVIDER=mock
MOCK_PAYMENTS_SECRET=change-me-locally

# PayFast. Both values come with your merchant account; the secured key signs
# callbacks and must never reach a browser. PAYFAST_BASE_URL defaults to the
# UAT host - set it to the production host PayFast gives you when going live.
# The fee listed prices are grossed up by is SITE.payments.gatewayFeePercent
# in src/lib/site.ts, not an env var, because the browser renders prices too.
# Three wire details in lib/payments/providers/payfast.ts are marked VERIFY.
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MERCHANT_NAME=Berke Pak Fabrics
PAYFAST_BASE_URL=

# 1LINK 1GO (Raast P2M). Fill these once you have sandbox credentials, then set
# PAYMENTS_PROVIDER=onelink. The wire format in lib/payments/providers/onelink.ts
# is UNVERIFIED until you read the spec behind the 1LINK sandbox login.
ONELINK_BASE_URL=
ONELINK_CLIENT_ID=
ONELINK_CLIENT_SECRET=
ONELINK_MERCHANT_ID=
ONELINK_WEBHOOK_SECRET=

# --- Rate limiting (optional; falls back to in-memory) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OTP delivery for Cash on Delivery (optional) ---
# Without these the code is logged to the server console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Analytics (optional; only injected when set) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
