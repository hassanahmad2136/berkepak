# --- Supabase ---
# Local dev (npx supabase start prints these):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
#
# Cloud: copy from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by email-confirmation links + OAuth redirects.
# Set to your prod URL when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin ---
# Comma-separated emails granted access to /admin/*
ADMIN_EMAILS=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# FROM address shown to customers. Defaults to SMTP_USER if not set.
SMTP_FROM=info@berkepakfabrics.com

# --- Analytics (optional; only injected when set) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Saleor (backend lives in ../backend; not yet wired into the storefront) ---
NEXT_PUBLIC_SALEOR_API_URL=
SALEOR_APP_TOKEN=
